  "azzle-deposit-usdc": {
    "description": "AZZLE protocol — unsigned USDC deposit batch for one explicitly selected V2 market. Returns approve(exactUsdcIn) + fundWithUsdc calldata; x402 payment does not credit the deposit ledger.",
    "price": "0.10",
    "methods": [
      "GET",
      "POST"
    ],
    "mimeType": "application/json",
    "extensions": {
      "bazaar": {
        "info": {
          "input": {
            "type": "http",
            "method": "POST",
            "bodyType": "json",
            "body": {
              "market": "micro",
              "usdcAmount": "10"
            }
          },
          "output": {
            "type": "json",
            "example": {
              "unsigned": true,
              "executesOnchain": false,
              "market": "micro",
              "transactions": []
            }
          }
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "input": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "http"
                },
                "method": {
                  "type": "string",
                  "enum": [
                    "POST"
                  ]
                },
                "bodyType": {
                  "type": "string",
                  "const": "json"
                },
                "body": {
                  "type": "object",
                  "properties": {
                    "market": {
                      "type": "string",
                      "enum": [
                        "standard",
                        "micro"
                      ],
                      "description": "Required V2 market; deposit graphs never mix"
                    },
                    "exactUsdcIn": {
                      "type": "string",
                      "description": "USDC amount in 6-decimal integer units. Required unless usdcAmount is set."
                    },
                    "usdcAmount": {
                      "type": "string",
                      "description": "Human USDC amount, e.g. \"10\". Required unless exactUsdcIn is set."
                    },
                    "minAzlOut": {
                      "type": "string",
                      "description": "Optional minimum AZL wei out. Overrides slippageBps when set."
                    },
                    "slippageBps": {
                      "type": "number",
                      "description": "Slippage bound in bps (0-5000). Default 100 (1%). Ignored if minAzlOut is set."
                    },
                    "deadline": {
                      "type": "number",
                      "description": "Optional unix seconds. Must be now..now+600; default now+480."
                    }
                  },
                  "required": [
                    "market"
                  ],
                  "examples": [
                    {
                      "market": "micro",
                      "usdcAmount": "10"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "method",
                "bodyType"
              ],
              "additionalProperties": false
            },
            "output": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "example": {
                  "type": "object"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "required": [
            "input"
          ]
        }
      }
    }
  },
  "azzle-post-task": {
    "description": "AZZLE protocol — unsigned post() batch to open a task on one explicitly selected V2 market. Distinct from azzle-open-tasks (which lists POSTED tasks). x402 payment does not post or fund the task.",
    "price": "0.15",
    "methods": [
      "GET",
      "POST"
    ],
