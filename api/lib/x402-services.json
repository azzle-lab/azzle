              "market": "micro",
              "totalAmount": "1000000000000000000",
              "durationSeconds": 604800
            }
          },
          "output": {
            "type": "json",
            "example": {
              "unsigned": true,
              "executesOnchain": false,
              "expectedTaskId": "v2:micro:1",
              "transactions": []
            }
          }
        },
