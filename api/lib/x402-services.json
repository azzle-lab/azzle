                  "type": "object",
                  "properties": {
                    "market": {
                      "type": "string",
                      "enum": [
                        "standard",
                        "micro"
                      ],
                      "description": "Required V2 market; must match the graph you will sign against"
                    },
                    "totalAmount": {
                      "type": "string",
                      "description": "Task budget in AZL wei (decimal integer string)"
                    },
                    "durationSeconds": {
                      "type": "number",
