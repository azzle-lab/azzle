{
  "mcpServers": {
    "azzle": {
      "command": "node",
      "args": ["${workspaceFolder}/agents/mcp/server.mjs"],
      "cwd": "${workspaceFolder}/agents",
      "env": {
        "AZZLE_MCP_ALLOWLIST": "read"
      }
    },
    "base-mcp": {
      "url": "https://mcp.base.org"
    },
    "typesafe": {
      "command": "node",
      "args": ["${workspaceFolder}/agents/mcp/typesafe-server.mjs"],
      "cwd": "${workspaceFolder}/agents",
      "env": {
        "TYPESAFE_API_KEY": "${TYPESAFE_API_KEY}"
      }
    }
  }
}
