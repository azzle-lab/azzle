# Base mainnet RPC
AZZLE_RPC_URL=https://mainnet.base.org
AZZLE_MARKET=standard

# Wallet private key (never commit .env)
PRIVATE_KEY=0x...

# XMTP (worker/poster negotiation)
XMTP_ENV=production
XMTP_DB_PATH=./.xmtp-db

# Autonomous DeepSeek arbitrator
# Bankr LLM Gateway
BANKR_API_KEY=bk_...
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://llm.bankr.bot/v1
AUTONOMOUS_ONCHAIN=false
AUTONOMOUS_INTERVAL_MS=60000
AUTONOMOUS_LOOKBACK_BLOCKS=50000
