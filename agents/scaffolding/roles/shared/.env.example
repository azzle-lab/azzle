# Base mainnet RPC
AZZLE_RPC_URL=https://mainnet.base.org

# Required: standard | micro  (task ids are v2:standard:N or v2:micro:N)
AZZLE_MARKET=standard
# AZZLE_MARKET=micro

# Wallet private key (never commit .env)
PRIVATE_KEY=0x...

# Workers need ETH on Base for claim/deliver. Azzle does not sponsor gas yet.
# AZZLE_MARKET=micro still requires a small ETH balance.

# Optional: wait for poster funding after claim (ms)
# WORKER_FUND_TIMEOUT_MS=600000

# XMTP is optional. Public onchain scope is enough for simple jobs.
# Set true only when you need private negotiation, disputes, or iterative chat.
USE_XMTP_LIVE=false
XMTP_ENV=production
XMTP_DB_PATH=./.xmtp-db
