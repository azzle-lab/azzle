{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzle.org/schemas/xmtp/dispute-notice/v2",
  "title": "DisputeNotice",
  "description": "Notice coordinating a V2 openDispute action against a proof submission.",
  "type": "object",
  "required": ["type", "taskId", "disputeId", "proofSubmissionBlock", "evidenceHash", "claim"],
  "properties": {
    "type": { "const": "azzle/DisputeNotice" },
    "taskId": { "type": "string", "pattern": "^[0-9]+$" },
    "disputeId": { "type": "string", "pattern": "^[0-9]+$" },
    "proofSubmissionBlock": { "type": "string", "pattern": "^[0-9]+$" },
    "evidenceHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
    "claim": { "enum": ["non_delivery", "quality", "scope", "payment", "other"] },
    "noticedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
