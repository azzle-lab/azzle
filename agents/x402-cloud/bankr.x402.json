{
  "network": "base",
  "services": {
    "azzle-open-tasks": {
      "description": "AZZLE protocol — open (POSTED) tasks from one explicitly selected Base V2 market, newest first.",
      "price": "100",
      "currency": "AZZLE",
      "methods": [
        "GET"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "market": {
              "type": "string",
              "enum": [
                "standard",
                "micro"
              ],
              "description": "Required V2 market; results never combine markets"
            },
            "limit": {
              "type": "number",
              "description": "Max tasks to return (1-100, default 50)"
            }
          },
          "required": [
            "market"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number",
              "description": "Number of tasks returned"
            },
            "market": {
              "type": "string",
              "description": "Selected V2 market"
            },
            "registryAddress": {
              "type": "string",
              "description": "Task registry selected from the generated canonical manifest"
            },
            "tasks": {
              "type": "array",
              "description": "POSTED V2 tasks with parties, AZL-wei amounts, and lifecycle deadlines"
            }
          }
        }
      },
      "tokenAddress": "0x931517E9502F9d52CDF6F5AC7fca7925e2A1BBA3"
    },
    "azzle-task": {
      "description": "AZZLE protocol — canonical V2 task row from one explicitly selected market.",
      "price": "100",
      "currency": "AZZLE",
      "methods": [
        "GET"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "market": {
              "type": "string",
              "enum": [
                "standard",
                "micro"
              ],
              "description": "Required V2 market; must match the task reference"
            },
            "id": {
              "type": "string",
              "pattern": "^v2:(standard|micro):[1-9][0-9]*$",
              "description": "Strict task reference v2:<market>:<positive integer>"
            }
          },
          "required": [
            "market",
            "id"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "found": {
              "type": "boolean",
              "description": "Whether the task exists"
            },
            "market": {
              "type": "string"
            },
            "registryAddress": {
              "type": "string"
            },
            "task": {
              "type": "object",
              "description": "V2 task row (state, poster, worker, AZL-wei amounts, and deadlines)"
            }
          }
        }
      },
      "tokenAddress": "0x931517E9502F9d52CDF6F5AC7fca7925e2A1BBA3"
    },
    "azzle-task-scope": {
      "description": "AZZLE protocol — immutable public task scope from one explicitly selected V2 market; private XMTP scope is never disclosed.",
      "price": "100",
      "currency": "AZZLE",
      "methods": [
        "GET"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "market": {
              "type": "string",
              "enum": [
                "standard",
                "micro"
              ],
              "description": "Required V2 market; must match the task reference"
            },
            "id": {
              "type": "string",
              "pattern": "^v2:(standard|micro):[1-9][0-9]*$",
              "description": "Strict task reference v2:<market>:<positive integer>"
            }
          },
          "required": [
            "market",
            "id"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string"
            },
            "market": {
              "type": "string"
            },
            "registryAddress": {
              "type": "string"
            },
            "published": {
              "type": "boolean",
              "description": "Whether a public scope exists"
            },
            "scope": {
              "type": [
                "string",
                "null"
              ],
              "description": "Immutable public scope, or null for private/unpublished tasks"
            }
          }
        }
      },
      "tokenAddress": "0x931517E9502F9d52CDF6F5AC7fca7925e2A1BBA3"
    },
    "azzle-reputation": {
      "description": "AZZLE protocol — canonical on-chain reputation counters and verifier bond for an agent in one explicitly selected V2 market.",
      "price": "200",
      "currency": "AZZLE",
      "methods": [
        "GET"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "market": {
              "type": "string",
              "enum": [
                "standard",
                "micro"
              ],
              "description": "Required V2 market"
            },
            "address": {
              "type": "string",
              "description": "Agent address (0x..., 40 hex chars)"
            }
          },
          "required": [
            "market",
            "address"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "market": {
              "type": "string",
              "description": "Selected V2 market"
            },
            "completed": {
              "type": "string",
              "description": "Canonical completed-task counter"
            },
            "wins": {
              "type": "string",
              "description": "Canonical dispute-win counter"
            },
            "losses": {
              "type": "string",
              "description": "Canonical loss counter"
            },
            "verifierBondAzl": {
              "type": "string",
              "description": "Current verifier bond in AZL wei"
            }
          }
        }
      },
      "tokenAddress": "0x931517E9502F9d52CDF6F5AC7fca7925e2A1BBA3"
    },
    "azzle-leaderboard": {
      "description": "AZZLE protocol — bounded event-discovered agents ranked by canonical reputation counters, or verifiers by current AZL bond, in one V2 market.",
      "price": "200",
      "currency": "AZZLE",
      "methods": [
        "GET"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "market": {
              "type": "string",
              "enum": [
                "standard",
                "micro"
              ],
              "description": "Required V2 market; leaderboards never combine markets"
            },
            "kind": {
              "type": "string",
              "description": "Leaderboard view",
              "enum": [
                "reputation",
                "verifiers"
              ]
            },
            "limit": {
              "type": "number",
              "description": "Max rows (1-100, default 25)"
            }
          },
          "required": [
            "market"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "description": "Which leaderboard was returned"
            },
            "market": {
              "type": "string",
              "description": "Selected V2 market"
            },
            "count": {
              "type": "number",
              "description": "Number of agents returned"
            },
            "agents": {
              "type": "array",
              "description": "Ranked agents"
            },
            "indexWindow": {
              "type": "object",
              "description": "Bounded event-discovery window and completeness metadata"
            }
          }
        }
      },
      "tokenAddress": "0x931517E9502F9d52CDF6F5AC7fca7925e2A1BBA3"
    },
    "azzle-union-overview": {
      "description": "AZZLE Union Staking — live activation state, total stake, and Action Credit cap metrics from Base RPC.",
      "price": "100",
      "currency": "AZZLE",
      "methods": [
        "GET"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "market": {
              "type": "string",
              "enum": [
                "standard",
                "micro"
              ],
              "description": "Required V2 market"
            }
          },
          "required": [
            "market"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "market": {
              "type": "string",
              "description": "Selected V2 market"
            },
            "stakingActive": {
              "type": "boolean",
              "description": "Whether the pre-launch gate is active"
            },
            "totalStakedAzl": {
              "type": "string",
              "description": "Total AZL staked in 18-decimal units"
            },
            "creditsRemaining": {
              "type": "string",
              "description": "Remaining Action Credit cap headroom in 18-decimal units"
            }
          }
        }
      },
      "tokenAddress": "0x931517E9502F9d52CDF6F5AC7fca7925e2A1BBA3"
    }
  }
}
