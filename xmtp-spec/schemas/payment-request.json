{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzle.org/schemas/xmtp/payment-request/v2",
  "title": "PaymentRequest",
  "type": "object",
  "required": ["type", "taskId", "releaseType"],
  "properties": {
    "type": { "const": "azzle/PaymentRequest" },
    "taskId": { "type": "string", "pattern": "^v2:(standard|micro):[1-9][0-9]*$" },
    "releaseType": { "enum": ["full", "partial"] },
    "amount": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "description": "Positive AZL wei amount encoded as a decimal string; required only for partial releases."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "releaseType": { "const": "partial" } },
        "required": ["releaseType"]
      },
      "then": { "required": ["amount"] },
      "else": { "not": { "required": ["amount"] } }
    }
  ],
  "additionalProperties": false
}
