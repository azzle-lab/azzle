{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzle.org/schemas/xmtp/delivery-notice/v2",
  "title": "DeliveryNotice",
  "type": "object",
  "description": "Off-chain delivery metadata sent after the worker calls TaskRegistry.markDelivered(taskId).",
  "required": ["type", "taskId", "receiptHash"],
  "properties": {
    "type": { "const": "azzle/DeliveryNotice" },
    "taskId": { "type": "string", "pattern": "^[0-9]+$" },
    "receiptHash": { "type": "string" },
    "receiptUri": { "type": "string", "format": "uri" },
    "artifactUris": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
