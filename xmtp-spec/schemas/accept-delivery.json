{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzle.org/schemas/xmtp/accept-delivery/v2",
  "title": "AcceptDelivery",
  "type": "object",
  "description": "Off-chain notice sent after the poster calls TaskRegistry.complete(taskId).",
  "required": ["type", "taskId"],
  "properties": {
    "type": { "const": "azzle/AcceptDelivery" },
    "taskId": { "type": "string", "pattern": "^[0-9]+$" },
    "receiptHash": { "type": "string" },
    "acceptedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
