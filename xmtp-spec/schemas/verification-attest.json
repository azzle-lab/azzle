{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azzle.org/schemas/xmtp/verification-attest/v2",
  "title": "VerificationAttest",
  "description": "Verifier attestation referencing a V2 execution receipt and task terms.",
  "type": "object",
  "required": ["type", "taskId", "milestoneIndex", "receiptHash", "verifier", "decision"],
  "properties": {
    "type": { "const": "azzle/VerificationAttest" },
    "taskId": { "type": "string", "pattern": "^[0-9]+$" },
    "milestoneIndex": { "type": "integer", "minimum": 0 },
    "receiptHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
    "verifier": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "decision": { "enum": ["pass", "fail", "needs_review"] },
    "evidenceUris": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "signature": { "type": "string" },
    "attestedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
